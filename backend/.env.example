# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/agency_marketing
NODE_ENV=development
PORT=5000

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed admin — created automatically on first DB init if no admins exist
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@youragency.com
SEED_ADMIN_PASSWORD=change-this-password

# ── Email (SMTP — Nodemailer) ──────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=hello@youragency.com
ADMIN_EMAIL=admin@youragency.com
APP_NAME=Anvil Digital

# ── AWS S3 (file uploads) ──────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# ── App ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Error tracking (Sentry) — optional, no-ops without it ─────
SENTRY_DSN=

# ── Razorpay (premium subscriptions) — optional, no-ops without it ─────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Generated separately in the Razorpay dashboard's webhook settings — not the same value as KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=
